<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ร้านของมุก</title>

<style>
*{
  box-sizing:border-box;
}

html,body{
  margin:0;
  padding:0;
  min-height:100%;
}

body{
  font-family:Arial,"Noto Sans Thai",sans-serif;
  background:#fff7fb;
  color:#29252b;
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.app{
  width:100%;
  max-width:600px;
  min-height:100vh;
  margin:auto;
  padding-bottom:90px;
}

/* HEADER */

.header{
  position:sticky;
  top:0;
  z-index:10;
  background:#fff7fb;
  border-bottom:1px solid #eee4eb;
}

.header-inner{
  height:64px;
  padding:0 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.shop-name{
  font-size:20px;
  font-weight:800;
}

.account-btn{
  border:1px solid #eadfe6;
  background:#fff;
  border-radius:20px;
  padding:8px 14px;
}

/* PROMO */

.promo{
  margin:16px;
  min-height:180px;
  border-radius:24px;
  background:linear-gradient(
    135deg,
    #ff78ad,
    #ffb0ce
  );
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:24px;
  color:white;
  overflow:hidden;
}

.promo-title{
  font-size:27px;
  font-weight:900;
}

.promo-text{
  margin-top:7px;
  font-size:14px;
}

/* CATEGORY */

.category-wrap{
  padding:0 16px 12px;
  overflow-x:auto;
}

.categories{
  display:flex;
  gap:8px;
  width:max-content;
}

.category{
  background:#fff;
  border:1px solid #eadfe6;
  padding:9px 16px;
  border-radius:30px;
}

.category.active{
  background:#ff70a8;
  border-color:#ff70a8;
  color:#fff;
}

/* SECTION */

.section{
  padding:0 16px;
}

.section-title{
  font-size:20px;
  font-weight:800;
  margin:10px 0 14px;
}

/* PRODUCTS */

.products{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.product{
  position:relative;
  background:#fff;
  border-radius:18px;
  overflow:hidden;
  border:1px solid #eee4eb;
}

.product-image{
  width:100%;
  aspect-ratio:1/1;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff0f6;
  font-size:48px;
}

.product-info{
  padding:12px;
}

.product-name{
  font-size:16px;
  font-weight:800;
}

.product-description{
  color:#8f8790;
  font-size:12px;
  min-height:32px;
  margin-top:4px;
}

.product-bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:10px;
}

.price{
  color:#ff5798;
  font-weight:900;
}

.add-button{
  width:36px;
  height:36px;
  border-radius:50%;
  background:#ff70a8;
  color:white;
  border:0;
  font-size:22px;
}

.product-closed{
  position:absolute;
  inset:0;
  background:rgba(255,255,255,.78);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  color:#777;
}

/* CART */

.cart{
  position:fixed;
  z-index:20;
  bottom:76px;
  left:50%;
  transform:translateX(-50%);
  width:calc(100% - 28px);
  max-width:572px;
  background:#29252b;
  color:white;
  border-radius:18px;
  padding:12px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.cart.hidden{
  display:none;
}

.cart-small{
  color:#ddd;
  font-size:12px;
}

.cart-button{
  background:#ff70a8;
  border:0;
  color:white;
  border-radius:12px;
  padding:10px 16px;
  font-weight:800;
}

/* BOTTOM NAV */

.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:65px;
  background:#fff;
  border-top:1px solid #eee4eb;
  display:flex;
  justify-content:center;
  z-index:30;
}

.nav-inner{
  width:100%;
  max-width:600px;
  display:flex;
  justify-content:space-around;
  align-items:center;
}

.nav-button{
  border:0;
  background:none;
  color:#8f8790;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:3px;
  font-size:11px;
}

.nav-button.active{
  color:#ff5798;
  font-weight:800;
}

.nav-icon{
  font-size:21px;
}

/* MODAL */

.modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:100;
  background:rgba(0,0,0,.45);
  align-items:flex-end;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:100%;
  max-width:600px;
  max-height:90vh;
  overflow-y:auto;
  margin:auto auto 0;
  background:#fff;
  border-radius:25px 25px 0 0;
  padding:20px;
}

.modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.modal-head h2{
  margin:0;
}

.close-button{
  width:36px;
  height:36px;
  border:0;
  border-radius:50%;
  background:#f5edf2;
  font-size:22px;
}

.field{
  margin-bottom:14px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:800;
  margin-bottom:6px;
}

.field input,
.field select,
.field textarea{
  width:100%;
  padding:12px;
  border:1px solid #e7dce4;
  border-radius:12px;
  background:#fff;
  outline:none;
}

.primary-button{
  width:100%;
  border:0;
  border-radius:13px;
  padding:13px;
  background:#ff70a8;
  color:#fff;
  font-weight:800;
}

.secondary-button{
  width:100%;
  border:0;
  border-radius:13px;
  padding:13px;
  background:#f5edf2;
  color:#29252b;
  font-weight:800;
  margin-top:8px;
}

.hidden{
  display:none !important;
}

/* ORDER ITEM */

.order-item{
  border:1px solid #eee4eb;
  border-radius:14px;
  padding:12px;
  margin-bottom:10px;
}

.order-row{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.order-status{
  display:inline-block;
  margin-top:8px;
  padding:5px 9px;
  border-radius:20px;
  background:#fff0f6;
  color:#ff5798;
  font-size:12px;
  font-weight:800;
}

/* ADMIN */

.admin-page{
  padding:16px;
}

.admin-card{
  background:#fff;
  border:1px solid #eee4eb;
  border-radius:18px;
  padding:16px;
  margin-bottom:12px;
}

.admin-title{
  font-size:18px;
  font-weight:900;
  margin-bottom:12px;
}

.admin-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.small-button{
  border:0;
  border-radius:10px;
  padding:8px 12px;
  background:#ff70a8;
  color:#fff;
  font-weight:700;
}

.status{
  padding:5px 10px;
  border-radius:20px;
  font-size:12px;
  font-weight:800;
}

.status.open{
  background:#e8f8ef;
  color:#238557;
}

.status.closed{
  background:#ffeaea;
  color:#d24c4c;
}

/* MOBILE */

@media(max-width:400px){

  .products{
    gap:8px;
  }

  .product-info{
    padding:10px;
  }

  .product-name{
    font-size:14px;
  }

}
</style>
</head>

<body>

<div class="app">

  <!-- HEADER -->

  <header class="header">

    <div class="header-inner">

      <div
        class="shop-name"
        id="shopName">
        ร้านของมุก
      </div>

      <button
        class="account-btn"
        id="accountButton">
        บัญชี
      </button>

    </div>

  </header>


  <!-- SHOP -->

  <main id="shopPage">

    <section class="promo">

      <div
        class="promo-title"
        id="promoTitle">
        วันนี้มีอะไรอร่อยบ้าง?
      </div>

      <div
        class="promo-text"
        id="promoText">
        เลือกของที่อยากกินได้เลย
      </div>

    </section>


    <!-- CATEGORY -->

    <div class="category-wrap">

      <div
        class="categories"
        id="categories">
      </div>

    </div>


    <!-- PRODUCTS -->

    <section class="section">

      <div class="section-title">
        รายการสินค้า
      </div>

      <div
        class="products"
        id="products">
      </div>

    </section>

  </main>


  <!-- CART -->

  <div
    class="cart hidden"
    id="cart">

    <div>

      <div>
        ตะกร้าสินค้า
      </div>

      <div
        class="cart-small"
        id="cartCount">
        0 รายการ
      </div>

    </div>

    <button
      class="cart-button"
      id="checkoutButton">
      ดูรายการ
    </button>

  </div>


  <!-- BOTTOM NAV -->

  <nav class="bottom-nav">

    <div class="nav-inner">

      <button
        class="nav-button active"
        id="navShop">

        <span class="nav-icon">⌂</span>
        ร้านค้า

      </button>

      <button
        class="nav-button"
        id="navOrders">

        <span class="nav-icon">🧾</span>
        ออเดอร์

      </button>

      <button
        class="nav-button"
        id="navReviews">

        <span class="nav-icon">★</span>
        รีวิว

      </button>

      <button
        class="nav-button"
        id="navAccount">

        <span class="nav-icon">○</span>
        บัญชี

      </button>

    </div>

  </nav>

</div>


<!-- ACCOUNT MODAL -->

<div
  class="modal"
  id="accountModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>บัญชีลูกค้า</h2>

      <button
        class="close-button"
        id="closeAccount">
        ×
      </button>

    </div>


    <div class="field">

      <label>
        ชื่อเล่น
      </label>

      <input
        id="customerName"
        type="text"
        placeholder="กรอกชื่อเล่น">

    </div>


    <div class="field">

      <label>
        อายุ
      </label>

      <input
        id="customerAge"
        type="number"
        placeholder="กรอกอายุ">

    </div>


    <div class="field">

      <label>
        วันเดือนปีเกิด
      </label>

      <input
        id="customerBirth"
        type="date">

    </div>


    <div class="field">

      <label>
        รูปยืนยันตัวตน
      </label>

      <input
        id="identityPhoto"
        type="file"
        accept="image/*"
        capture="user">

    </div>


    <button
      class="primary-button"
      id="saveCustomer">
      บันทึกข้อมูล
    </button>

  </div>

</div>


<!-- CHECKOUT MODAL -->

<div
  class="modal"
  id="checkoutModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>ตรวจสอบออเดอร์</h2>

      <button
        class="close-button"
        id="closeCheckout">
        ×
      </button>

    </div>


    <div id="checkoutItems"></div>


    <div
      style="
        display:flex;
        justify-content:space-between;
        font-weight:900;
        margin:15px 0;
      ">

      <span>
        รวมทั้งหมด
      </span>

      <span
        id="checkoutTotal">
        ฿0
      </span>

    </div>


    <div class="field">

      <label>
        วิธีชำระเงิน
      </label>

      <select id="paymentMethod">

        <option value="">
          เลือกวิธีชำระเงิน
        </option>

        <option value="transfer">
          โอนเงิน
        </option>

        <option value="cash">
          เงินสด
        </option>

      </select>

    </div>


    <div
      id="transferBox"
      class="hidden">

      <div class="field">

        <label>
          แนบสลิป
        </label>

        <input
          id="slip"
          type="file"
          accept="image/*">

      </div>

      <div
        style="
          font-size:13px;
          color:#8f8790;
          margin-bottom:12px;
        ">

        การโอนต้องชำระอย่างน้อย 50%
        ของยอดทั้งหมด

      </div>

    </div>


    <div
      id="cashBox"
      class="hidden">

      <div class="field">

        <label>
          จะมารับภายในกี่นาที?
        </label>

        <input
          id="pickupMinutes"
          type="number"
          min="1"
          placeholder="เช่น 20">

      </div>

    </div>


    <button
      class="primary-button"
      id="submitOrder">
      ยืนยันออเดอร์
    </button>

  </div>

</div>


<!-- ORDERS MODAL -->

<div
  class="modal"
  id="ordersModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>ออเดอร์ของฉัน</h2>

      <button
        class="close-button"
        id="closeOrders">
        ×
      </button>

    </div>

    <div id="ordersList"></div>

  </div>

</div>


<!-- REVIEWS MODAL -->

<div
  class="modal"
  id="reviewsModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>รีวิว</h2>

      <button
        class="close-button"
        id="closeReviews">
        ×
      </button>

    </div>


    <div id="reviewsList">

      <div class="order-item">
        ⭐⭐⭐⭐⭐
        <br>
        อร่อยมากกก
      </div>

      <div class="order-item">
        ⭐⭐⭐⭐
        <br>
        ชอบมาก ไว้กลับมาซื้ออีก
      </div>

    </div>


    <button
      class="primary-button"
      id="writeReview">
      เขียนรีวิว
    </button>

  </div>

</div>


<script>

/* =========================================
   DATA
========================================= */

const products = [

  {
    id:1,
    name:"ข้าวไก่ทอด",
    price:50,
    category:"อาหาร",
    emoji:"🍗",
    description:"ข้าวไก่ทอดกรอบ",
    open:true
  },

  {
    id:2,
    name:"แซนด์วิช",
    price:35,
    category:"อาหาร",
    emoji:"🥪",
    description:"แซนด์วิชไส้แน่น",
    open:true
  },

  {
    id:3,
    name:"น้ำแดง",
    price:20,
    category:"เครื่องดื่ม",
    emoji:"🥤",
    description:"เครื่องดื่มเย็น ๆ",
    open:false
  },

  {
    id:4,
    name:"โยเกิร์ตสตรอว์เบอร์รี",
    price:45,
    category:"ของหวาน",
    emoji:"🍓",
    description:"โยเกิร์ตหวานละมุน",
    open:true
  }

];


let cart = [];

let currentCategory = "ทั้งหมด";


/* =========================================
   ELEMENTS
========================================= */

const categories =
  document.getElementById("categories");

const productsBox =
  document.getElementById("products");

const cartBox =
  document.getElementById("cart");

const cartCount =
  document.getElementById("cartCount");


/* =========================================
   CATEGORY
========================================= */

function renderCategories(){

  const categoryList = [
    "ทั้งหมด",
    ...new Set(
      products.map(
        function(product){
          return product.category;
        }
      )
    )
  ];


  categories.innerHTML = "";


  categoryList.forEach(
    function(category){

      const button =
        document.createElement("button");

      button.className = "category";

      if(category === currentCategory){

        button.classList.add("active");

      }

      button.textContent = category;


      button.addEventListener(
        "click",
        function(){

          currentCategory = category;

          renderCategories();
          renderProducts();

        }
      );


      categories.appendChild(button);

    }
  );

}


/* =========================================
   PRODUCTS
========================================= */

function renderProducts(){

  productsBox.innerHTML = "";


  let list = products;


  if(currentCategory !== "ทั้งหมด"){

    list = products.filter(
      function(product){

        return (
          product.category ===
          currentCategory
        );

      }
    );

  }


  list.forEach(
    function(product){

      const card =
        document.createElement("div");

      card.className = "product";


      const image =
        document.createElement("div");

      image.className =
        "product-image";

      image.textContent =
        product.emoji;


      const info =
        document.createElement("div");

      info.className =
        "product-info";


      const name =
        document.createElement("div");

      name.className =
        "product-name";

      name.textContent =
        product.name;


      const description =
        document.createElement("div");

      description.className =
        "product-description";

      description.textContent =
        product.description;


      const bottom =
        document.createElement("div");

      bottom.className =
        "product-bottom";


      const price =
        document.createElement("div");

      price.className = "price";

      price.textContent =
        "฿" + product.price;


      bottom.appendChild(price);


      if(product.open){

        const add =
          document.createElement("button");

        add.className =
          "add-button";

        add.textContent = "+";


        add.addEventListener(
          "click",
          function(){

            addToCart(product.id);

          }
        );


        bottom.appendChild(add);

      }else{

        const closedText =
          document.createElement("span");

        closedText.style.fontSize =
          "12px";

        closedText.style.color =
          "#8f8790";

        closedText.textContent =
          "ปิดขาย";

        bottom.appendChild(
          closedText
        );

      }


      info.appendChild(name);

      info.appendChild(description);

      info.appendChild(bottom);


      card.appendChild(image);

      card.appendChild(info);


      if(!product.open){

        const closed =
          document.createElement("div");

        closed.className =
          "product-closed";

        closed.textContent =
          "ปิดขาย";

        card.appendChild(closed);

      }


      productsBox.appendChild(card);

    }
  );

}


/* =========================================
   CART
========================================= */

function addToCart(id){

  const product =
    products.find(
      function(item){
        return item.id === id;
      }
    );


  if(!product || !product.open){

    return;

  }


  const existing =
    cart.find(
      function(item){
        return item.id === id;
      }
    );


  if(existing){

    existing.quantity += 1;

  }else{

    cart.push({
      id:product.id,
      name:product.name,
      price:product.price,
      quantity:1
    });

  }


  updateCart();

}


function updateCart(){

  let total = 0;


  cart.forEach(
    function(item){

      total += item.quantity;

    }
  );


  cartCount.textContent =
    total + " รายการ";


  if(total > 0){

    cartBox.classList.remove(
      "hidden"
    );

  }else{

    cartBox.classList.add(
      "hidden"
    );

  }

}


/* =========================================
   MODALS
========================================= */

function openModal(id){

  document
    .getElementById(id)
    .classList.add("show");

}


function closeModal(id){

  document
    .getElementById(id)
    .classList.remove("show");

}


/* =========================================
   ACCOUNT
========================================= */

document
  .getElementById("accountButton")
  .addEventListener(
    "click",
    function(){

      openModal("accountModal");

    }
  );


document
  .getElementById("navAccount")
  .addEventListener(
    "click",
    function(){

      openModal("accountModal");

    }
  );


document
  .getElementById("closeAccount")
  .addEventListener(
    "click",
    function(){

      closeModal("accountModal");

    }
  );


document
  .getElementById("saveCustomer")
  .addEventListener(
    "click",
    function(){

      const name =
        document
          .getElementById("customerName")
          .value
          .trim();


      const age =
        document
          .getElementById("customerAge")
          .value;


      const birth =
        document
          .getElementById("customerBirth")
          .value;


      const photo =
        document
          .getElementById("identityPhoto")
          .files[0];


      if(
        !name ||
        !age ||
        !birth ||
        !photo
      ){

        alert(
          "กรุณากรอกข้อมูลให้ครบ"
        );

        return;

      }


      localStorage.setItem(
        "customer",
        JSON.stringify({
          name:name,
          age:age,
          birth:birth,
          verified:false
        })
      );


      alert(
        "บันทึกข้อมูลแล้ว"
      );


      closeModal(
        "accountModal"
      );

    }
  );


/* =========================================
   CHECKOUT
========================================= */

document
  .getElementById("checkoutButton")
  .addEventListener(
    "click",
    function(){

      if(cart.length === 0){

        return;

      }


      const box =
        document.getElementById(
          "checkoutItems"
        );


      box.innerHTML = "";


      let total = 0;


      cart.forEach(
        function(item){

          const row =
            document.createElement(
              "div"
            );

          row.className =
            "order-item";


          const subtotal =
            item.price *
            item.quantity;


          total += subtotal;


          row.innerHTML =
            "<div class='order-row'>" +
            "<span>" +
            item.name +
            " × " +
            item.quantity +
            "</span>" +
            "<strong>฿" +
            subtotal +
            "</strong>" +
            "</div>";


          box.appendChild(row);

        }
      );


      document
        .getElementById(
          "checkoutTotal"
        )
        .textContent =
        "฿" + total;


      openModal(
        "checkoutModal"
      );

    }
  );


document
  .getElementById("closeCheckout")
  .addEventListener(
    "click",
    function(){

      closeModal(
        "checkoutModal"
      );

    }
  );


/* PAYMENT */

document
  .getElementById("paymentMethod")
  .addEventListener(
    "change",
    function(){

      const value =
        this.value;


      document
        .getElementById(
          "transferBox"
        )
        .classList.toggle(
          "hidden",
          value !== "transfer"
        );


      document
        .getElementById(
          "cashBox"
        )
        .classList.toggle(
          "hidden",
          value !== "cash"
        );

    }
  );


/* SUBMIT ORDER */

document
  .getElementById("submitOrder")
  .addEventListener(
    "click",
    function(){

      const method =
        document
          .getElementById(
            "paymentMethod"
          )
          .value;


      if(!method){

        alert(
          "กรุณาเลือกวิธีชำระเงิน"
        );

        return;

      }


      if(method === "transfer"){

        const slip =
          document
            .getElementById("slip")
            .files[0];


        if(!slip){

          alert(
            "กรุณาแนบสลิป"
          );

          return;

        }

      }


      if(method === "cash"){

        const minutes =
          document
            .getElementById(
              "pickupMinutes"
            )
            .value;


        if(!minutes){

          alert(
            "กรุณาระบุเวลารับสินค้า"
          );

          return;

        }

      }


      const orders =
        JSON.parse(
          localStorage.getItem(
            "orders"
          ) || "[]"
        );


      const order = {

        id:
          "ORD-" +
          Date.now(),

        items:
          JSON.parse(
            JSON.stringify(cart)
          ),

        payment:
          method,

        status:
          "กำลังรอร้านรับออเดอร์",

        date:
          new Date().toLocaleString(
            "th-TH"
          )

      };


      orders.push(order);


      localStorage.setItem(
        "orders",
        JSON.stringify(orders)
      );


      cart = [];

      updateCart();


      closeModal(
        "checkoutModal"
      );


      alert(
        "ส่งออเดอร์เรียบร้อยแล้ว"
      );

    }
  );


/* =========================================
   ORDERS
========================================= */

document
  .getElementById("navOrders")
  .addEventListener(
    "click",
    function(){

      renderOrders();

      openModal(
        "ordersModal"
      );

    }
  );


document
  .getElementById("closeOrders")
  .addEventListener(
    "click",
    function(){

      closeModal(
        "ordersModal"
      );

    }
  );


function renderOrders(){

  const box =
    document.getElementById(
      "ordersList"
    );


  const orders =
    JSON.parse(
      localStorage.getItem(
        "orders"
      ) || "[]"
    );


  box.innerHTML = "";


  if(orders.length === 0){

    box.innerHTML =
      "<p style='text-align:center;color:#8f8790'>" +
      "ยังไม่มีออเดอร์" +
      "</p>";

    return;

  }


  orders
    .slice()
    .reverse()
    .forEach(
      function(order){

        const item =
          document.createElement(
            "div"
          );


        item.className =
          "order-item";


        let html =
          "<strong>" +
          order.id +
          "</strong>";


        html +=
          "<div style='margin-top:7px;font-size:13px'>" +
          order.date +
          "</div>";


        order.items.forEach(
          function(product){

            html +=
              "<div>" +
              product.name +
              " × " +
              product.quantity +
              "</div>";

          }
        );


        html +=
          "<div class='order-status'>" +
          order.status +
          "</div>";


        item.innerHTML =
          html;


        box.appendChild(item);

      }
    );

}


