<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>ร้านของมุก</title>

<style>
:root{
  --bg:#fff7fb;
  --card:#ffffff;
  --ink:#29252b;
  --muted:#8e8790;
  --line:#eee4eb;
  --main:#ff6fa8;
  --main2:#ff91bd;
  --danger:#ff5d5d;
  --success:#4caf7d;
  --shadow:0 8px 25px rgba(80,40,60,.08);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",
  "Noto Sans Thai",sans-serif;
  background:var(--bg);
  color:var(--ink);
}

button,input,select,textarea{
  font:inherit;
}

button{
  border:0;
  cursor:pointer;
}

.app{
  max-width:600px;
  margin:auto;
  min-height:100vh;
  background:var(--bg);
}

/* HEADER */

.header{
  position:sticky;
  top:0;
  z-index:20;
  background:rgba(255,247,251,.95);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}

.header-inner{
  padding:16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.shop-name{
  font-size:20px;
  font-weight:800;
}

.account-btn{
  background:white;
  border:1px solid var(--line);
  border-radius:50px;
  padding:8px 14px;
}

/* HERO */

.hero{
  margin:16px;
  min-height:190px;
  border-radius:24px;
  background:white;
  overflow:hidden;
  position:relative;
  box-shadow:var(--shadow);
}

.hero img{
  width:100%;
  height:100%;
  min-height:190px;
  object-fit:cover;
  display:block;
}

.hero-content{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:22px;
  background:linear-gradient(
    transparent,
    rgba(0,0,0,.55)
  );
  color:white;
}

.hero-title{
  font-size:27px;
  font-weight:900;
}

.hero-text{
  margin-top:5px;
}

/* CATEGORY */

.categories{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:2px 16px 14px;
}

.categories::-webkit-scrollbar{
  display:none;
}

.category{
  flex:0 0 auto;
  background:white;
  border:1px solid var(--line);
  border-radius:50px;
  padding:9px 16px;
}

.category.active{
  background:var(--main);
  color:white;
  border-color:var(--main);
}

/* PRODUCTS */

.section{
  padding:5px 16px 100px;
}

.section-title{
  font-size:20px;
  font-weight:850;
  margin:12px 0;
}

.products{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.product{
  background:white;
  border-radius:18px;
  overflow:hidden;
  box-shadow:var(--shadow);
  position:relative;
}

.product-image{
  width:100%;
  aspect-ratio:1/1;
  object-fit:cover;
  background:#f5edf2;
}

.product-info{
  padding:12px;
}

.product-name{
  font-weight:750;
}

.product-desc{
  font-size:13px;
  color:var(--muted);
  margin-top:4px;
  min-height:34px;
}

.product-bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:10px;
}

.price{
  font-weight:850;
  color:var(--main);
}

.add-btn{
  width:36px;
  height:36px;
  border-radius:50%;
  background:var(--main);
  color:white;
  font-size:22px;
}

.closed{
  position:absolute;
  inset:0;
  background:rgba(255,255,255,.75);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

/* CART */

.cart-bar{
  position:fixed;
  left:50%;
  bottom:14px;
  transform:translateX(-50%);
  width:min(568px,calc(100% - 28px));
  background:#29252b;
  color:white;
  padding:14px 18px;
  border-radius:18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  box-shadow:0 12px 35px rgba(0,0,0,.2);
}

.cart-count{
  font-weight:800;
}

.checkout-btn{
  background:var(--main);
  color:white;
  padding:10px 17px;
  border-radius:12px;
  font-weight:750;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  z-index:50;
  display:none;
  align-items:flex-end;
  justify-content:center;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:min(600px,100%);
  max-height:90vh;
  overflow:auto;
  background:white;
  border-radius:25px 25px 0 0;
  padding:20px;
}

.modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.close{
  width:35px;
  height:35px;
  border-radius:50%;
  background:#f5eef2;
}

.field{
  margin-bottom:14px;
}

.field label{
  display:block;
  font-size:14px;
  font-weight:700;
  margin-bottom:6px;
}

.field input,
.field textarea,
.field select{
  width:100%;
  padding:12px;
  border:1px solid var(--line);
  border-radius:12px;
  outline:none;
  background:white;
}

.primary{
  width:100%;
  padding:13px;
  border-radius:13px;
  background:var(--main);
  color:white;
  font-weight:800;
}

.secondary{
  width:100%;
  padding:13px;
  border-radius:13px;
  background:#f5eef2;
  color:var(--ink);
  font-weight:750;
  margin-top:8px;
}

/* NAV */

.bottom-nav{
  position:fixed;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:min(600px,100%);
  height:65px;
  background:white;
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-around;
  align-items:center;
  z-index:30;
}

.nav-item{
  background:none;
  color:var(--muted);
  font-size:12px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:3px;
}

.nav-item.active{
  color:var(--main);
  font-weight:800;
}

.nav-icon{
  font-size:21px;
}

/* ADMIN */

.admin{
  padding:16px;
  padding-bottom:100px;
}

.admin-card{
  background:white;
  border-radius:18px;
  padding:16px;
  margin-bottom:12px;
  box-shadow:var(--shadow);
}

.admin-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}

.badge{
  padding:5px 10px;
  border-radius:50px;
  font-size:12px;
  font-weight:750;
}

.badge.open{
  background:#e8f8ef;
  color:#238557;
}

.badge.closed{
  position:static;
  background:#ffeaea;
  color:#c33;
}

.hidden{
  display:none!important;
}

@media(max-width:430px){
  .products{
    grid-template-columns:1fr 1fr;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- HEADER -->

  <header class="header">
    <div class="header-inner">

      <div class="shop-name" id="shopName">
        ร้านของมุก
      </div>

      <button
        class="account-btn"
        onclick="openAccount()">
        บัญชี
      </button>

    </div>
  </header>


  <!-- SHOP HOME -->

  <main id="shopPage">

    <section class="hero">

      <img
        id="heroImage"
        src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1000&q=80"
        alt="โปรโมชั่น">

      <div class="hero-content">

        <div
          class="hero-title"
          id="heroTitle">
          วันนี้มีอะไรอร่อยบ้าง?
        </div>

        <div
          class="hero-text"
          id="heroText">
          เลือกของที่อยากกินได้เลย
        </div>

      </div>

    </section>


    <!-- CATEGORIES -->

    <div
      class="categories"
      id="categories">
    </div>


    <!-- PRODUCTS -->

    <section class="section">

      <div class="section-title">
        รายการสินค้า
      </div>

      <div
        class="products"
        id="products">
      </div>

    </section>

  </main>


  <!-- CART -->

  <div
    class="cart-bar hidden"
    id="cartBar">

    <div>

      <div>
        ตะกร้า
      </div>

      <div
        class="cart-count"
        id="cartCount">
        0 รายการ
      </div>

    </div>

    <button
      class="checkout-btn"
      onclick="openCheckout()">
      ชำระเงิน
    </button>

  </div>


  <!-- BOTTOM NAV -->

  <nav class="bottom-nav">

    <button
      class="nav-item active"
      onclick="showShop()">

      <span class="nav-icon">⌂</span>
      ร้านค้า

    </button>

    <button
      class="nav-item"
      onclick="openOrders()">

      <span class="nav-icon">🧾</span>
      ออเดอร์

    </button>

    <button
      class="nav-item"
      onclick="openReviews()">

      <span class="nav-icon">★</span>
      รีวิว

    </button>

    <button
      class="nav-item"
      onclick="openAccount()">

      <span class="nav-icon">○</span>
      บัญชี

    </button>

  </nav>

</div>


<!-- ACCOUNT MODAL -->

<div
  class="modal"
  id="accountModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>บัญชีลูกค้า</h2>

      <button
        class="close"
        onclick="closeModal('accountModal')">
        ×
      </button>

    </div>

    <div id="accountContent">

      <div class="field">

        <label>
          ชื่อเล่น
        </label>

        <input
          id="customerName"
          placeholder="ชื่อเล่น">

      </div>


      <div class="field">

        <label>
          อายุ
        </label>

        <input
          id="customerAge"
          type="number"
          min="1"
          max="120"
          placeholder="อายุ">

      </div>


      <div class="field">

        <label>
          วันเกิด
        </label>

        <input
          id="customerBirth"
          type="date">

      </div>


      <div class="field">

        <label>
          รูปยืนยันตัวตน
        </label>

        <input
          id="identityPhoto"
          type="file"
          accept="image/*"
          capture="user">

      </div>


      <button
        class="primary"
        onclick="saveCustomer()">

        บันทึกบัญชี

      </button>

    </div>

  </div>

</div>


<!-- CHECKOUT -->

<div
  class="modal"
  id="checkoutModal">

  <div class="modal-box">

    <div class="modal-head">

      <h2>ตรวจสอบรายการ</h2>

      <button
        class="close"
        onclick="closeModal('checkoutModal')">
        ×
      </button>

    </div>


    <div id="checkoutItems"></div>


    <hr
      style="border:0;border-top:1px solid var(--line);margin:15px 0">


    <div
      style="display:flex;justify-content:space-between;font-weight:800">

      <span>
        รวม
      </span>

      <span
        id="checkoutTotal">
        ฿0
      </span>

    </div>


    <br>


    <div class="field">

      <label>
        วิธีชำระเงิน
      </label>

      <select id="paymentMethod">

        <option value="">
          เลือกวิธีชำระ
        </option>

        <option value="transfer">
          โอนเงิน
        </option>

        <option value="cash">
          เงินสด
        </option>

      </select>

    </div>


    <div
      id="transferBox"
      class="hidden">

      <div class="field">

        <label>
          สลิปการโอน
        </label>

        <input
          type="file"
          id="slip"
          accept="image/*">

      </div>

      <p
        style="font-size:13px;color:var(--muted);margin-bottom:12px">

        ต้องชำระอย่างน้อย 50% ของยอดซื้อ

      </p>

    </div>


    <div
      id="cashBox"
      class="hidden">

      <div class="field">

        <label>
          จะมารับภายในกี่นาที?
        </label>

        <input
          type="number"
          id="pickupMinutes"
          min="1"
          placeholder="เช่น 20">

      </div>

    </div>


    <button
      class="primary"
      onclick="submitOrder()">

      ยืนยันออเดอร์

    </button>

  </div>

</div>


<script>

/* =========================
   DEMO DATA
========================= */

const products = [

  {
    id:1,
    name:"ข้าวไก่ทอด",
    price:50,
    category:"อาหาร",
    image:"https://images.unsplash.com/photo-1512058564366-18510be2db19?auto=format&fit=crop&w=800&q=80",
    description:"ไก่ทอดกรอบพร้อมข้าว",
    open:true
  },

  {
    id:2,
    name:"แซนด์วิช",
    price:35,
    category:"อาหาร",
    image:"https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=800&q=80",
    description:"แซนด์วิชไส้แน่น",
    open:true
  },

  {
    id:3,
    name:"น้ำแดง",
    price:20,
    category:"เครื่องดื่ม",
    image:"https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=800&q=80",
    description:"เครื่องดื่มเย็น ๆ",
    open:false
  },

  {
    id:4,
    name:"โยเกิร์ตสตรอว์เบอร์รี",
    price:45,
    category:"ของหวาน",
    image:"https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=800&q=80",
    description:"โยเกิร์ตพร้อมสตรอว์เบอร์รี",
    open:true
  }

];


let cart = [];

let currentCategory = "ทั้งหมด";


/* =========================
   RENDER CATEGORY
========================= */

function renderCategories(){

  const box =
    document.getElementById("categories");

  const cats = [
    "ทั้งหมด",
    ...new Set(
      products.map(p => p.category)
    )
  ];

  box.innerHTML = cats.map(cat => `

    <button
      class="category ${cat === currentCategory ? "active" : ""}"
      onclick="selectCategory('${cat}')">

      ${cat}

    </button>

  `).join("");

}


/* =========================
   RENDER PRODUCTS
========================= */

function renderProducts(){

  const box =
    document.getElementById("products");

  let list = products;

  if(currentCategory !== "ทั้งหมด"){

    list =
      products.filter(
        p => p.category === currentCategory
      );

  }

  box.innerHTML = list.map(p => `

    <article class="product">

      <img
        class="product-image"
        src="${p.image}"
        alt="${p.name}">

      <div class="product-info">

        <div class="product-name">
          ${p.name}
        </div>

        <div class="product-desc">
          ${p.description}
        </div>

        <div class="product-bottom">

          <div class="price">
            ฿${p.price}
          </div>

          ${
            p.open
            ? `
              <button
                class="add-btn"
                onclick="addToCart(${p.id})">
                +
              </button>
            `
            : `
              <span
                style="font-size:12px;color:var(--muted)">
                ปิดขาย
              </span>
            `
          }

        </div>

      </div>

      ${
        !p.open
        ? `
          <div class="closed">
            ปิดขาย
          </div>
        `
        : ""
      }

    </article>

  `).join("");

}


/* =========================
   CATEGORY
========================= */

function selectCategory(category){

  currentCategory = category;

  renderCategories();
  renderProducts();

}


/* =========================
   CART
========================= */

function addToCart(id){

  const product =
    products.find(p => p.id === id);

  if(!product || !product.open) return;

  const existing =
    cart.find(item => item.id === id);

  if(existing){

    existing.quantity++;

  }else{

    cart.push({
      ...product,
      quantity:1
    });

  }

  updateCart();

}


function updateCart(){

  const bar =
    document.getElementById("cartBar");

  const count =
    cart.reduce(
      (sum,item) =>
      sum + item.quantity,
      0
    );

  document.getElementById("cartCount")
    .textContent =
    `${count} รายการ`;

  if(count > 0){

    bar.classList.remove("hidden");

  }else{

    bar.classList.add("hidden");

  }

}


/* =========================
   CHECKOUT
========================= */

function openCheckout(){

  if(cart.length === 0) return;

  const box =
    document.getElementById("checkoutItems");

  box.innerHTML =
    cart.map(item => `

      <div
        style="
          display:flex;
          justify-content:space-between;
          margin-bottom:10px;
        ">

        <span>
          ${item.name}
          × ${item.quantity}
        </span>

        <b>
          ฿${item.price * item.quantity}
        </b>

      </div>

    `).join("");


  const total =
    cart.reduce(
      (sum,item) =>
      sum + item.price * item.quantity,
      0
    );

  document.getElementById("checkoutTotal")
    .textContent =
    `฿${total}`;

  document
    .getElementById("checkoutModal")
    .classList.add("show");

}


document
  .getElementById("paymentMethod")
  .addEventListener("change", function(){

    document
      .getElementById("transferBox")
      .classList.toggle(
        "hidden",
        this.value !== "transfer"
      );

    document
      .getElementById("cashBox")
      .classList.toggle(
        "hidden",
        this.value !== "cash"
      );

  });


/* =========================
   ORDER
========================= */

function submitOrder(){

  const method =
    document.getElementById("paymentMethod")
      .value;

  if(!method){

    alert("กรุณาเลือกวิธีชำระเงิน");

    return;

  }


  if(method === "transfer"){

    const slip =
      document.getElementById("slip").files[0];

    if(!slip){

      alert("กรุณาแนบสลิป");

      return;

    }

  }


  if(method === "cash"){

    const minutes =
      document.getElementById("pickupMinutes")
        .value;

    if(!minutes){

      alert("กรุณาระบุเวลาที่จะมารับ");

      return;

    }

  }


  const order = {

    id:
      "ORD-" +
      Date.now(),

    items:[...cart],

    payment:method,

    status:"กำลังรอร้านรับออเดอร์",

    createdAt:
      new Date().toISOString()

  };


  const orders =
    JSON.parse(
      localStorage.getItem("orders")
      || "[]"
    );

  orders.push(order);

  localStorage.setItem(
    "orders",
    JSON.stringify(orders)
  );


  cart = [];

  updateCart();

  closeModal("checkoutModal");

  alert(
    "ส่งออเดอร์ให้ร้านแล้ว ❤️"
  );

}


/* =========================
   CUSTOMER
========================= */

function openAccount(){

  document
    .getElementById("accountModal")
    .classList.add("show");

}


function saveCustomer(){

  const name =
    document.getElementById("customerName")
      .value.trim();

  const age =
    document.getElementById("customerAge")
      .value;

  const birth =
    document.getElementById("customerBirth")
      .value;

  const photo =
    document.getElementById("identityPhoto")
      .files[0];


  if(!name || !age || !birth){

    alert(
      "กรุณากรอกข้อมูลให้ครบ"
    );

    return;

  }


  if(!photo){

    alert(
      "กรุณาแนบรูปสำหรับยืนยันตัวตน"
    );

    return;

  }


  const customer = {

    name,
    age,
    birth,

    /*
      รูปจะไม่ถูกเก็บลง localStorage
      ในระบบจริงจะส่งเข้า storage
      ของ Backend ที่ปลอดภัย
    */

    verified:false

  };


  localStorage.setItem(
    "customer",
    JSON.stringify(customer)
  );


  alert(
    "บันทึกข้อมูลแล้ว รอร้านตรวจสอบ"
  );

}


/* =========================
   ORDERS
========================= */

function openOrders(){

  const orders =
    JSON.parse(
      localStorage.getItem("orders")
      || "[]"
    );

  let text =
    "ออเดอร์ของคุณ\n\n";

  if(!orders.length){

    text +=
      "ยังไม่มีออเดอร์";

  }else{

    orders.forEach(order => {

      text +=
        `${order.id}\n`;

      text +=
        `สถานะ: ${order.status}\n\n`;

    });

  }

  alert(text);

}


/* =========================
   REVIEWS
========================= */

function openReviews(){

  alert(
    "หน้าระบบรีวิวจะเชื่อมกับฐานข้อมูลในขั้นต่อไป"
  );

}


/* =========================
   SHOP
========================= */

function showShop(){

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* =========================
   MODAL
========================= */

function closeModal(id){

  document
